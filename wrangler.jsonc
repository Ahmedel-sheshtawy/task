{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-helm-haqeqa",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-helm-haqeqa-db",
      "database_id": "b4a2e881-ea78-480b-a583-02f4b897c6b1",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STUDY_ROOMS",
        "class_name": "StudyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StudyRoom"
      ]
    }
  ]
}
