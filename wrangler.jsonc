{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-helm-haqeqa-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el-helm-haqeqa-v2-prod",
      "database_id": "65a0175a-32f6-42f0-a49b-46a1343710ae",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STUDY_ROOMS",
        "class_name": "StudyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StudyRoom"
      ]
    }
  ]
}
